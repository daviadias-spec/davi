programa
{
	
	funcao inicio()
	{
		escreva("Olá Mundo")
		escreva("oi")

verificarStatus()





	}
funcao verificarStatus()
	{
		inteiro temperatura

		escreva(" ---- CONTROLE DE MAQUINAS ----")

		

escreva(" digite a temperatura da maquina: ")
leia(temperatura)
		se(temperatura  <= 80)
		{escreva("esta maquina es normal")
		}senao 
		{escreva("esta sobre aquicida a maquina")

	}}}
