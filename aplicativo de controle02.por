programa
{
	
	funcao inicio()
	{
		escreva("Olá Mundo")
		escreva("oi")

verificarStatus()

registrarProducao()



	}
funcao verificarStatus()
	{
		inteiro temperatura

		escreva(" ---- CONTROLE DE MAQUINAS ----")

		

escreva(" digite a temperatura da maquina: ")
leia(temperatura)
		se(temperatura  <= 80)
		{escreva("esta maquina es normal\n")
		}senao 
		{escreva("esta sobre aquicida a maquina\n")

	}}funcao registrarProducao()
	{inteiro pecas

	escreva("digite a qunatidade de pecas produzidas  ")
	leia(pecas)
	escreva("\nproducao registrada "+ pecas ," pecas")
	
	}}
